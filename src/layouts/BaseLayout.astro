---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, draftPages } from '../data/site';

interface Props {
  /** Page title without the brand suffix. The homepage passes its full title. */
  title: string;
  description: string;
  /** Also implied for paths in draftPages. Noindex pages get no canonical URL. */
  noindex?: boolean;
  image?: { src: string; alt: string };
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  image = { src: '/og-default.png', alt: `${site.name} — ${site.tagline}` },
  jsonLd = [],
} = Astro.props;

const path = Astro.url.pathname;
const isDraft = draftPages.includes(path);
const indexable = !noindex && !isDraft;
const fullTitle = path === '/' ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(path, site.url).href;
const imageUrl = new URL(image.src, site.url).href;
const structuredData =
  jsonLd.length > 0 ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }) : null;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={site.themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#konten">Langsung ke konten</a>
    <Header />
    {
      isDraft && (
        <div class="draft-banner" role="note">
          <div class="container">
            <strong>Draf:</strong> halaman ini belum final dan menunggu peninjauan sebelum dipublikasikan.
          </div>
        </div>
      )
    }
    <main id="konten" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }

  .draft-banner {
    padding-block: 0.75rem;
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
    font-size: 0.9375rem;
  }
</style>
