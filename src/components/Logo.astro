---
// Box mark matches the tools.kukirim.com favicon; the wordmark uses system fonts.
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="6" fill="var(--color-accent)"></rect>
    <g fill="none" stroke="var(--color-on-accent)" stroke-width="2" stroke-linejoin="round">
      <path d="M8 11l8-4 8 4v10l-8 4-8-4z"></path>
      <path d="M8 11l8 4 8-4M16 15v10"></path>
    </g>
  </svg>
  <span class="wordmark">Kukirim</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wordmark {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
</style>
